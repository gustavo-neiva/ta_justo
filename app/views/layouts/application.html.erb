<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
    <%= stylesheet_link_tag "design_tokens", "base",
        "components/badges","components/buttons","components/cards","components/forms",
        "components/search_bar","components/empty_state","components/skeleton",
        "components/pagination","components/data_table","components/tabs",
        "components/header","components/footer","components/accordion","components/tags",
        "components/chart",
        "layouts/index_page","layouts/detail_page","layouts/landing_page",
        "domain/ta_justo",
        "data-turbo-track": "reload" %>
    <%= render "layouts/posthog" %>
  </head>
  <body>
    <%= render "shared/header" %>
    <main class="<%= content_for(:page_class) %>">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
