<title><%= content_for(:title) || "Tá Justo? — Índice de Preços CEASA-RJ para Rio de Janeiro" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Tá Justo?">
<meta name="mobile-web-app-capable" content="yes">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%# Meta Description %>
<meta name="description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : 'Compare preços de feira com atacado CEASA-RJ. Descubra se você está pagando justo.' %>">

<%# Open Graph Tags %>
<meta property="og:title" content="<%= content_for?(:title) ? content_for(:title) : 'Tá Justo? — Índice de Preços CEASA-RJ' %>">
<meta property="og:description" content="Compare preços de feira com atacado CEASA-RJ. Descubra se você está pagando justo.">
<meta property="og:url" content="<%= request.original_url %>">
<meta property="og:type" content="website">

<%# Canonical URL %>
<link rel="canonical" href="<%= content_for?(:canonical_url) ? content_for(:canonical_url) : request.url.split('?').first %>">

<%= yield :head %>

<%# Inter Font - Google Fonts (non-blocking) %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>

<%# Icons %>
<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon-192.png">

<meta name="theme-color" content="#035925">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="manifest" href="/manifest.json">

<%= javascript_importmap_tags %>
