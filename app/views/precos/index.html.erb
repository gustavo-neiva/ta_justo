<% content_for :page_class, "index-page" %>
<% content_for :title, "Preços CEASA-RJ Hoje — Tá Justo?" %>

<div class="page-container">
  <div class="page-header">
    <h1>Preços CEASA-RJ</h1>
    <% if @price_date %>
      <p class="subtitle">
        Atualizado: <%= I18n.l(@price_date, format: :long) %> (<%= @weekday %>)
        <% if @stale %>
          <span class="stale-badge">
            ⚠️ <%= (Date.current - @price_date).to_i %> dias atrás
          </span>
        <% end %>
      </p>
    <% end %>
  </div>

  <% unless @error %>
    <%= form_with url: precos_path, method: :get, class: "precos-filter",
          data: { controller: "list-filter",
                  list_filter_url_value: precos_path } do %>
      <input type="search" name="q" value="<%= params[:q] %>"
             placeholder="Buscar produto…" class="form-control"
             data-list-filter-target="searchInput"
             data-action="input->list-filter#debouncedSubmit">
    <% end %>
  <% end %>

  <% if @error %>
    <div class="empty-state">
      <p><%= @error %></p>
      <p style="margin-top: var(--space-md);">
        <%= link_to "← Voltar ao verificador", root_path, class: "button primary" %>
      </p>
    </div>
  <% elsif @sections.empty? %>
    <div class="empty-state">
      <p>Nenhum preço encontrado<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
    </div>
  <% else %>
    <%= turbo_frame_tag "precos-list", target: "_top" do %>
      <div class="price-sections">
        <% @sections.each do |_section_num, section_data| %>
          <div class="price-section">
            <div class="price-section-header">
              <h2><%= section_data[:name] %></h2>
              <span class="badge secondary"><%= section_data[:products].size %> produtos</span>
            </div>

            <div class="price-list">
              <div class="price-list-header">
                <span class="col-product">Produto</span>
                <span class="col-price">Preço/kg</span>
                <span class="col-epoca">Época</span>
              </div>

              <% section_data[:products].each do |product, prices| %>
                <% if prices.size > 1 %>
                  <div class="product-group">
                    <div class="product-group-header">
                      <span class="product-group-name"><%= product.name %></span>
                      <span class="badge badge-sm product-group-count"><%= prices.size %> tipos</span>
                    </div>
                    <% prices.each do |price| %>
                      <%
                        display_price = if price.price_per_kg
                          "R$ #{number_with_precision(price.price_per_kg, precision: 2)}/kg"
                        elsif price.modal
                          "R$ #{number_with_precision(price.modal, precision: 2)}"
                        else
                          "S/C"
                        end
                      %>
                      <%= link_to product_path(product.slug), class: "price-row price-row--variant" do %>
                        <span class="col-product variant-name"><%= price.variant.name %></span>
                        <span class="col-price price-value"><%= display_price %></span>
                        <span class="col-epoca"><%= epoca_pill(section_data[:timing][price.variant.id]) %></span>
                      <% end %>
                    <% end %>
                  </div>
                <% else %>
                  <%
                    price = prices.first
                    display_price = if price.price_per_kg
                      "R$ #{number_with_precision(price.price_per_kg, precision: 2)}/kg"
                    elsif price.modal
                      "R$ #{number_with_precision(price.modal, precision: 2)}"
                    else
                      "S/C"
                    end
                  %>
                  <%= link_to product_path(product.slug), class: "price-row" do %>
                    <span class="col-product product-name"><%= product.name %></span>
                    <span class="col-price price-value"><%= display_price %></span>
                    <span class="col-epoca"><%= epoca_pill(section_data[:timing][price.variant.id]) %></span>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="epoca-legend">
      <span>📉 Em época</span>
      <span class="epoca-legend-sep">·</span>
      <span>📊 Preço normal</span>
      <span class="epoca-legend-sep">·</span>
      <span>📈 Fora de época</span>
      <span class="epoca-legend-info">“Em época” = fase do ano em que o produto costuma ficar mais barato; “fora de época”, mais caro. Calculado sobre o histórico de preços, em reais de hoje (IPCA).</span>
    </div>

    <div style="margin-top: var(--space-xl); text-align: center;">
      <%= link_to "← Voltar ao verificador", root_path, class: "button secondary" %>
    </div>
  <% end %>
</div>
