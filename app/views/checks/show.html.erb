<% content_for :page_class, "checker-page" %>
<% content_for :title, "Tá Justo? — O índice de preços da CEASA-RJ" %>
<% search_index = CheckerCatalog.search_index(@items.to_h { |i| [ i.id, item_price_summary(@refs[i.id]) ] }) %>

<%= produce_icon_sprite(@items) %>
<div class="checker" data-controller="checker" data-checker-index-value="<%= search_index.to_json %>">
  <section class="checker-search">
    <h1 class="checker-title">Quanto é justo pagar? <span>Referência: atacado da CEASA-RJ</span></h1>
    <label for="checker-q" class="visually-hidden">O que você está vendo?</label>
    <input type="search" id="checker-q" class="checker-input"
           placeholder="O que você está vendo? ex: aipim, banana prata"
           autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search"
           <%= "autofocus" unless @open_item || @result || @error %>
           data-checker-target="input"
           data-action="input->checker#search focus->checker#lift keydown.enter->checker#pickFirst">
    <ol class="checker-results" data-checker-target="results" hidden aria-live="polite"></ol>
  </section>

  <% if @error %>
    <div class="verdict-result">
      <p style="color: var(--color-danger);"><strong><%= icon("x-circle") %> <%= @error %></strong></p>
    </div>
  <% end %>

  <% if @result %>
    <div class="verdict-result <%= @result.verdict %>"
         data-controller="posthog-event"
         data-posthog-event-name-value="price_check_completed"
         data-posthog-event-properties-value="<%= { product_slug: @product.slug, item: @open_item&.id, pricing_mode: @variant.pricing_mode, verdict: @result.verdict.to_s }.to_json %>">
      <div class="verdict-badge <%= @result.verdict %>">
        <%= markup_icon(@result.verdict) %> <%= markup_label(@result.verdict) %>
      </div>
      <h3><%= @open_item&.name || @product.name %> — <%= @open_item&.members&.find { |m| m.variant == @variant.name }&.label || @variant.name %></h3>
      <div class="verdict-price-row">
        <span>Você pagou: <strong><%= brl(@result.paid_comparable) %>/<%= @result.unit_label %></strong></span>
        <span>CEASA: <strong><%= brl(@result.ceasa_comparable) %>/<%= @result.unit_label %></strong></span>
        <span>Razão: <strong><%= "%.1f" % @result.ratio %>×</strong></span>
      </div>
      <div class="verdict-explanation"><%= @result.explanation %></div>
      <% if @result.stale %>
        <p><span class="stale-badge"><%= icon("exclamation-triangle") %> Preço CEASA de <%= (Date.current - @result.ceasa_date).to_i %> dias atrás</span></p>
      <% end %>
    </div>
  <% end %>

  <div class="checker-cards">
    <% @items.each do |item| %>
      <%= render "card", item: item, ref: @refs[item.id], open: @open_item == item %>
    <% end %>
  </div>

  <section class="checker-recent" data-checker-target="recent" hidden>
    <h2>Recentes</h2>
    <div class="tile-row" data-checker-target="recentList"></div>
  </section>

  <section class="checker-grid" data-checker-target="grid" aria-label="Escolha pelo que você vê">
    <% CheckerCatalog.by_group.each do |group, items| %>
      <% top, rest = items.partition(&:top) %>
      <h2><%= CheckerCatalog::GROUPS[group] %></h2>
      <div class="tile-grid">
        <% top.each do |item| %><%= render "tile", item: item %><% end %>
      </div>
      <% if rest.any? %>
        <details class="tile-more">
          <summary>Mais <%= CheckerCatalog::GROUPS[group].downcase %> (<%= rest.size %>)</summary>
          <div class="tile-grid">
            <% rest.each do |item| %><%= render "tile", item: item %><% end %>
          </div>
        </details>
      <% end %>
    <% end %>
  </section>

  <p class="checker-footnote">
    Referência: atacado da CEASA-RJ. Feira costuma cobrar de 1,7× a 2,5× o atacado (transporte, perdas, mão de obra).
    É um guia, não um preço absoluto. <%= link_to "Todos os preços de hoje →", precos_path, class: "link" %>
  </p>
</div>
