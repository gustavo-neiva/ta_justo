<% content_for :page_class, "detail-page" %>
<% content_for :title, "#{@product.name} — Preços CEASA-RJ — Tá Justo?" %>

<div class="page-container">
  <div class="page-header">
    <h1><%= @product.name %></h1>
    <p class="subtitle"><%= @variant.name %></p>
  </div>

  <% if @error %>
    <div class="empty-state">
      <p><%= @error %></p>
      <%= link_to "← Voltar aos preços", precos_path, class: "button primary" %>
    </div>
  <% else %>
    <!-- Latest Price -->
    <div class="product-header-stats">
      <div class="stat-card">
        <div class="stat-label">Último preço</div>
        <div class="stat-value">
          <% if @stats[:latest] %>
            R$ <%= number_with_precision(@stats[:latest], precision: 2) %>/kg
          <% else %>
            S/C
          <% end %>
        </div>
        <div class="stat-label" style="margin-top: var(--space-xs);">
          <%= I18n.l(@price_date, format: :short) %>
          <% if @stale %>
            <span class="stale-badge">desatualizado</span>
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-label">Mín. 12m</div>
        <div class="stat-value">
          <% if @stats[:min_12m] %>
            R$ <%= number_with_precision(@stats[:min_12m], precision: 2) %>
          <% else %>
            —
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-label">Máx. 12m</div>
        <div class="stat-value">
          <% if @stats[:max_12m] %>
            R$ <%= number_with_precision(@stats[:max_12m], precision: 2) %>
          <% else %>
            —
          <% end %>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-label">Média 12m</div>
        <div class="stat-value">
          <% if @stats[:avg_12m] %>
            R$ <%= number_with_precision(@stats[:avg_12m], precision: 2) %>
          <% else %>
            —
          <% end %>
        </div>
      </div>
    </div>

    <!-- Market Timing quiet line (paid-independent — always shown if available) -->
    <% unless @market_timing.null? %>
      <div class="timing-line">
        <span class="timing-bucket timing-bucket--<%= @market_timing.bucket %>">
          <%= timing_emoji(@market_timing.bucket) %>
          Mercado agora: <%= timing_label(@market_timing.bucket) %>
        </span>
        <span class="timing-detail">
          percentil <%= @market_timing.percentile %> dos últimos 12 meses
          (base <%= @market_timing.index_name.upcase %>
          <%= @market_timing.base_month.strftime("%b/%Y") %>)
        </span>
      </div>
    <% end %>

    <!-- Historical price chart -->
    <%= render "chart" %>

    <!-- Variant Selector -->
    <% if @variants.count > 1 %>
      <div class="variant-selector">
        <h3>Outras variantes</h3>
        <div class="variant-links">
          <% @variants.each do |v| %>
            <%= link_to v.name,
                product_path(@product.slug, request.query_parameters.merge(variant: v.id)),
                class: "variant-link #{'active' if v.id == @variant.id}" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Inline Verdict Calculator -->
    <div class="checker-container" style="max-width: 100%; margin-top: var(--space-xl); background: var(--color-background-secondary); padding: var(--space-lg); border-radius: var(--radius-lg);">
      <h3>Tá justo?</h3>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-md);">
        Digite o preço que você está pagando para comparar:
      </p>

      <%= form_with url: product_path(@product.slug), method: :get, class: "checker-form" do |f| %>
        <%= hidden_field_tag :variant, @variant.id %>
        <div class="form-group">
          <label for="check_price">Preço por <%= @unit_label %> (R$)</label>
          <input type="number" step="0.01" min="0.01" name="check_price" id="check_price"
                 class="form-control" placeholder="Ex: 8.50" value="<%= params[:check_price] %>">
        </div>

        <button type="submit" class="button primary">Verificar</button>
      <% end %>

      <% if @verdict_error %>
        <p class="verdict-error"><%= @verdict_error %></p>
      <% elsif @verdict %>
        <div class="verdict-result <%= @verdict.verdict %>" style="margin-top: var(--space-md);"
             data-controller="posthog-event"
             data-posthog-event-name-value="price check completed"
             data-posthog-event-properties-value="<%= { product_slug: @product.slug, pricing_mode: @variant.pricing_mode, selected_period: @period, verdict: @verdict.verdict.to_s }.to_json %>">

          <!-- Axis 1: Markup (loud, colored spine) -->
          <div class="verdict-axes">
            <div class="verdict-axis verdict-axis--markup">
              <div class="verdict-badge <%= @verdict.verdict %>">
                <%= markup_emoji(@verdict.verdict) %> <%= markup_label(@verdict.verdict) %>
              </div>
              <div class="verdict-axis-label">margem do vendedor</div>
            </div>

            <!-- Axis 2: MarketTiming (quiet secondary) -->
            <% unless @verdict.market_timing&.null? %>
              <div class="verdict-axis verdict-axis--timing">
                <div class="timing-badge timing-badge--<%= @verdict.market_timing.bucket %>">
                  <%= timing_emoji(@verdict.market_timing.bucket) %> <%= timing_label(@verdict.market_timing.bucket) %>
                </div>
                <div class="verdict-axis-label">momento do mercado</div>
              </div>
            <% end %>
          </div>

          <!-- Prices row -->
          <div class="verdict-price-row">
            <span>Você pagou: <strong>R$ <%= "%.2f" % @verdict.paid_comparable %>/<%= @verdict.unit_label %></strong></span>
            <span>CEASA: <strong>R$ <%= "%.2f" % @verdict.ceasa_comparable %>/<%= @verdict.unit_label %></strong></span>
            <span>Razão: <strong><%= "%.1f" % @verdict.ratio %>×</strong></span>
          </div>

          <!-- Synthesis (fires only on high-signal cells) -->
          <% if @verdict.synthesis_sentence.present? %>
            <div class="verdict-synthesis">
              💬 <%= @verdict.synthesis_sentence %>
            </div>
          <% end %>

          <div class="verdict-explanation"><%= @verdict.explanation %></div>
        </div>
      <% end %>
    </div>

    <!-- Raw Wholesale Data (collapsed, transparent source) -->
    <% if @raw_prices.present? %>
      <details class="accordion-item raw-data-details" style="margin-top: var(--space-lg);">
        <summary class="accordion-summary">
          <span class="accordion-title">
            <span class="accordion-title-text">📦 Dados brutos CEASA (<%= I18n.l(@price_date, format: :short) %>)</span>
          </span>
          <span class="accordion-indicator">▾</span>
        </summary>
        <div class="accordion-content">
          <p style="font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-bottom: var(--space-md);">
            Preços de atacado na origem. A linha marcada é a usada no cálculo acima.
          </p>
          <div class="raw-data-table-wrapper">
            <table class="raw-data-table">
              <thead>
                <tr>
                  <th>Embalagem</th>
                  <th class="num">Atacado</th>
                  <th class="num">Faixa</th>
                  <th class="num">R$/kg</th>
                  <th class="num">Var. 12m</th>
                </tr>
              </thead>
              <tbody>
                <% @raw_prices.each do |price| %>
                  <tr class="<%= 'raw-data-row--representative' if price.id == @representative_price_id %>">
                    <td>
                      <%= price.raw_unit %>
                      <% if price.id == @representative_price_id %>
                        <span class="raw-data-badge">usamos esta</span>
                      <% end %>
                    </td>
                    <td class="num"><%= price.modal ? "R$ #{'%.2f' % price.modal}" : '—' %></td>
                    <td class="num">
                      <% if price.min && price.max %>
                        R$ <%= '%.2f' % price.min %> – <%= '%.2f' % price.max %>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td class="num">
                      <% if price.price_per_kg.present? %>
                        R$ <%= "%.2f" % price.price_per_kg %>/kg
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td class="num"><%= price.variation_12m.presence || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </details>
    <% end %>

    <!-- Navigation -->
    <div style="margin-top: var(--space-xl); display: flex; justify-content: center; gap: var(--space-md); flex-wrap: wrap;">
      <%= link_to "← Todos os preços", precos_path, class: "button secondary" %>
      <%= link_to "Novo checker", root_path, class: "button primary" %>
    </div>
  <% end %>
</div>
